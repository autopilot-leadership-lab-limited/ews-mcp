# Public URL of this server (what AI apps are given), no trailing slash
EWS_MCP_BASE_URL=https://mail-mcp.example.com
# Exchange host name; EWS is at https://<host>/EWS/Exchange.asmx. Only this host is contacted.
EWS_MCP_EXCHANGE_HOST=mail.example.com
# Optional: NTLM or basic. Leave unset to auto-detect.
#EWS_MCP_EXCHANGE_AUTH=NTLM
# Where the process listens; the reverse proxy forwards here
EWS_MCP_BIND_HOST=127.0.0.1
EWS_MCP_BIND_PORT=8000
# Reverse-proxy addresses trusted for X-Forwarded-For (comma separated, or *)
EWS_MCP_FORWARDED_ALLOW_IPS=127.0.0.1
EWS_MCP_LOG_LEVEL=INFO
